# Files domain catalog — open this in Protégé
@prefix files: <https://aes-lighting.com/ns/files#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://aes-lighting.com/ns/files>
    a owl:Ontology ;
    dct:title "AES File Service Client Domain Ontology" ;
    dct:creator "file-service-client Spec Kit" ;
    dct:description "Normative for all agents. See .specify/spec.md. Markers: OntologyRequired PolicyNoSecretsInGit PolicyDualSurfaceHonesty PolicyNoInventLiveRoutesFromLib PolicyMvpDeferred" ;
    owl:versionInfo "0.1.0-baseline" ;
    rdfs:comment "Thin catalog. Imports generated structural TBox and curated axioms." ;
    owl:imports <https://aes-lighting.com/ns/files/generated> ,
                <https://aes-lighting.com/ns/files/axioms> .
